# Dokploy UI Environment Variables (all set in Dokploy dashboard, never in code)
# This file is used as reference. Copy to a local .env for dev only.

# =====================
# SERVER (api service)
# =====================
PORT=3001
NODE_ENV=production
DATA_DIR=/app/data
UPLOAD_DIR=/app/public/uploads
CORS_ORIGIN=https://yourdomain.com

# Firebase Service Account (Dokploy → paste full values)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# =====================
# CLIENT (web service)
# =====================
VITE_API_URL=https://api.yourdomain.com
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx
