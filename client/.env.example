# Client Environment Variables
# Copy to .env and fill with real values during deployment

# API base URL (no trailing slash)
# In dev, Vite proxy handles /api. In production, set to your deployed server.
VITE_API_URL=http://localhost:3001

# Firebase client config (set manually in Dokploy after creating Firebase app)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
