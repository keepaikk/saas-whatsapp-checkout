# Server Environment Variables
# Copy to .env and fill with real values during deployment

# Server port (default: 3001)
PORT=3001

# Node environment
NODE_ENV=development

# Data directory path (default: server/data/)
# In production, point to a persistent volume or mount
DATA_DIR=./data

# Upload directory path (default: server/public/uploads/)
UPLOAD_DIR=./public/uploads

# Allowed CORS origins (comma-separated)
# In production: set to your deployed frontend URL
CORS_ORIGIN=http://localhost:5173

# Firebase config (staging — fill when migrating from local JSON)
# Get these from Firebase Console → Project Settings → Service Accounts
# Then paste into Dokploy env vars manually
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Client Firebase (for auth / Firestore client SDK)
# FIREBASE_API_KEY=          # paste manually in Dokploy
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
